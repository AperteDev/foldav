using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog dialog {
  search-enabled: false;

  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Appearance");

      // Kept on this device only.
      Adw.ActionRow {
        title: _("Style");

        [suffix]
        Adw.ToggleGroup color_scheme {
          valign: center;

          Adw.Toggle {
            name: "system";
            label: C_("style", "System");
          }

          Adw.Toggle {
            name: "light";
            label: C_("style", "Light");
          }

          Adw.Toggle {
            name: "dark";
            label: C_("style", "Dark");
          }
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Files");

      // The `show_previews` setting, on unless set off (src/settings.rs `present`).
      Adw.SwitchRow preview_files {
        title: _("Preview Files");
        subtitle: _("Show images and the start of text files in the columns view");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Accounts");
    icon-name: "system-users-symbolic";

    // A row per account (src/settings.rs `connect_accounts`), each opening its page
    // (ui/account.blp).
    Adw.PreferencesGroup accounts {
      title: _("Accounts");

      header-suffix: Gtk.Button add_account {
        valign: center;
        tooltip-text: _("Add Account");
        styles ["flat"]

        Adw.ButtonContent {
          icon-name: "list-add-symbolic";
          label: _("Add");
        }
      };
    }

    Adw.PreferencesGroup sync {
      title: _("Sync");

      // Off, or one of the accounts (src/settings.rs `connect_settings_sync`).
      Adw.ComboRow settings_account {
        title: _("Sync settings with");
        subtitle: _("Accounts and servers always stay on this device");
        model: Gtk.StringList settings_accounts {};
      }
    }
  }
}
