using Gtk 4.0;
using Adw 1;

// Keyboard Shortcuts (Ctrl+?). Window-wide ones show the keys set in code by their action.
Adw.ShortcutsDialog dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Back");
      action-name: "win.back";
    }

    Adw.ShortcutsItem {
      title: _("Forward");
      action-name: "win.forward";
    }

    Adw.ShortcutsItem {
      title: _("Parent Folder");
      action-name: "win.up";
    }

    Adw.ShortcutsItem {
      title: _("Icons");
      action-name: "win.view-icons";
    }

    Adw.ShortcutsItem {
      title: _("List");
      action-name: "win.view-list";
    }

    Adw.ShortcutsItem {
      title: _("Columns");
      action-name: "win.view-columns";
    }

    Adw.ShortcutsItem {
      title: _("Zoom In");
      action-name: "win.zoom-in";
    }

    Adw.ShortcutsItem {
      title: _("Zoom Out");
      action-name: "win.zoom-out";
    }

    Adw.ShortcutsItem {
      title: _("Reset Zoom");
      action-name: "win.zoom-reset";
    }

    Adw.ShortcutsItem {
      title: _("Add Folder to Favorites");
      action-name: "win.favorite-add";
    }

    Adw.ShortcutsItem {
      title: _("Show Hidden Files");
      action-name: "win.show-hidden";
    }

    Adw.ShortcutsItem {
      title: _("Open");
      action-name: "win.open";
    }

    Adw.ShortcutsItem {
      title: _("Upload Files");
      action-name: "win.upload-files";
    }

    Adw.ShortcutsItem {
      title: _("New Folder");
      action-name: "win.new-folder";
    }

    Adw.ShortcutsItem {
      title: _("Rename");
      action-name: "win.rename";
    }

    Adw.ShortcutsItem {
      title: _("Cut");
      action-name: "win.cut";
    }

    Adw.ShortcutsItem {
      title: _("Copy");
      action-name: "win.copy";
    }

    Adw.ShortcutsItem {
      title: _("Paste");
      action-name: "win.paste";
    }

    Adw.ShortcutsItem {
      title: _("Move to Trash");
      action-name: "win.delete";
    }

    Adw.ShortcutsItem {
      title: _("Undo");
      action-name: "win.undo";
    }

    Adw.ShortcutsItem {
      title: _("Reload");
      action-name: "win.reload";
    }

    Adw.ShortcutsItem {
      title: _("Toggle Sidebar");
      action-name: "win.toggle-sidebar";
    }

    Adw.ShortcutsItem {
      title: _("Preferences");
      action-name: "win.preferences";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      action-name: "app.quit";
    }
  }
}
