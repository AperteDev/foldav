using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: "Foldav";
  default-width: 1100;
  default-height: 700;

  content: Adw.ToastOverlay toasts {
    Gtk.Stack stack {
      Gtk.StackPage {
        name: "welcome";

        // The first account to add (ui/add-account.blp, set in src/window.rs `welcome`).
        child: Adw.Bin welcome {};
      }

      Gtk.StackPage {
        name: "main";

        // As Nautilus: the sidebar hidden by itself on a narrow window, where it shows over the
        // files (and a button in the header, F9).
        child: Adw.OverlaySplitView split {
          min-sidebar-width: 220;
          max-sidebar-width: 300;

          // The accounts (only with more than one), the favorite folders of the account shown
          // and the tree of its folders (src/window/sidebar.rs).
          sidebar: Adw.ToolbarView {
            [top]
            Adw.HeaderBar {
              title-widget: Adw.WindowTitle {
                title: "Foldav";
              };

              [end]
              Gtk.MenuButton {
                icon-name: "open-menu-symbolic";
                menu-model: main_menu;
                tooltip-text: _("Main Menu");
                primary: true;
              }
            }

            // At the foot, not scrolled away: the long actions running, a row each, as Nautilus'
            // (src/window/transfers.rs), and what the account uses of its storage.
            [bottom]
            Gtk.Box {
              orientation: vertical;

              Gtk.Box transfers {
                orientation: vertical;
                spacing: 2;
                margin-start: 6;
                margin-end: 6;
                styles ["transfers"]
              }

              Gtk.Box quota_box {
                orientation: vertical;
                spacing: 6;
                margin-start: 12;
                margin-end: 12;
                margin-top: 10;
                margin-bottom: 12;
                visible: false;

                Gtk.Label quota {
                  xalign: 0;
                  styles ["caption", "dim-label"]
                }

                // How much of it (src/window/sidebar.rs `refresh_places`); red when little is
                // left.
                Gtk.ProgressBar quota_bar {
                  styles ["quota-bar"]
                }
              }
            }

            content: Gtk.ScrolledWindow {
              vexpand: true;
              hscrollbar-policy: never;

              Gtk.Box {
                orientation: vertical;

                Gtk.ListBox accounts {
                  styles ["navigation-sidebar"]
                }

                Gtk.Separator accounts_separator {
                  margin-top: 6;
                  margin-bottom: 6;
                }

                // The favorite folders, as Nextcloud Files lists them; all of this is hidden
                // while there are none.
                Gtk.Label favorites_heading {
                  label: _("Favorites");
                  xalign: 0;
                  margin-start: 12;
                  margin-top: 6;
                  margin-bottom: 2;
                  styles ["caption-heading", "dim-label"]
                }

                Gtk.ListBox favorites {
                  styles ["navigation-sidebar"]
                }

                Gtk.Separator favorites_separator {
                  margin-top: 6;
                  margin-bottom: 6;
                }

                // The places of Nextcloud Files that are not folders: Recent, Favorites, what
                // is shared, the tags, the trash bin (src/window/sidebar.rs).
                Gtk.ListBox places {
                  styles ["navigation-sidebar", "dense"]
                }

                Gtk.Separator places_separator {
                  margin-top: 6;
                  margin-bottom: 6;
                }

                Gtk.ListBox tree {
                  styles ["navigation-sidebar", "dense"]
                }
              }
            };
          };

          content: Adw.ToolbarView {
            // As Nautilus' header: back and forward (and the folder above), the path bar taking
            // the room between them and the views, the view switcher and menu. A plain row,
            // not an AdwHeaderBar: that one keeps its title in the middle, and the path bar
            // is to reach from the buttons on.
            [top]
            Gtk.WindowHandle {
              Gtk.Box {
                styles ["toolbar"]

                Gtk.ToggleButton {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: _("Toggle Sidebar (F9)");
                  active: bind split.show-sidebar bidirectional;
                  visible: bind split.collapsed;
                }

                Gtk.Box {
                  styles ["linked"]

                  Gtk.Button {
                    icon-name: "go-previous-symbolic";
                    tooltip-text: _("Back (Alt+Left)");
                    action-name: "win.back";
                  }

                  Gtk.Button {
                    icon-name: "go-next-symbolic";
                    tooltip-text: _("Forward (Alt+Right)");
                    action-name: "win.forward";
                  }

                  Gtk.Button {
                    icon-name: "go-up-symbolic";
                    tooltip-text: _("Parent Folder (Alt+Up)");
                    action-name: "win.up";
                  }
                }

                // The path bar, or (a click on its room, Ctrl+L) the path to type in its place
                // (src/window/header.rs).
                Gtk.Box pathbar_box {
                  styles ["pathbar"]
                  hexpand: true;
                  valign: center;

                  // The segments of the folder's path, each opening that folder.
                  Gtk.ScrolledWindow pathbar_scroll {
                    hexpand: true;
                    hscrollbar-policy: external;
                    vscrollbar-policy: never;
                    propagate-natural-height: true;

                    Gtk.Box pathbar {}
                  }

                  Gtk.MenuButton {
                    icon-name: "view-more-symbolic";
                    menu-model: path_menu;
                    tooltip-text: _("Folder Menu");
                    styles ["flat"]
                  }
                }

                Gtk.Box location_box {
                  hexpand: true;
                  valign: center;
                  visible: false;
                  styles ["linked"]

                  Gtk.Entry location_entry {
                    hexpand: true;
                    valign: center;
                    placeholder-text: _("Enter a folder's path");
                    secondary-icon-name: "edit-clear-symbolic";
                    secondary-icon-tooltip-text: _("Clear");
                    styles ["location-entry"]
                  }

                  Gtk.Button location_close {
                    icon-name: "window-close-symbolic";
                    tooltip-text: _("Close the Location (Esc)");
                    valign: center;
                    styles ["location-close"]
                  }
                }

                // The search to type, in the place of the path bar (src/window/header.rs).
                Gtk.Box search_box {
                  hexpand: true;
                  valign: center;
                  visible: false;

                  Gtk.Entry search_entry {
                    hexpand: true;
                    valign: center;
                    primary-icon-name: "system-search-symbolic";
                    secondary-icon-name: "edit-clear-symbolic";
                    secondary-icon-tooltip-text: _("Clear");
                    placeholder-text: _("Search here");
                    styles ["search-field"]
                  }
                }

                Gtk.ToggleButton search_toggle {
                  icon-name: "system-search-symbolic";
                  tooltip-text: _("Search (Ctrl+F)");
                  valign: center;
                }

                Adw.ToggleGroup view_toggle {
                  valign: center;

                  Adw.Toggle {
                    name: "icons";
                    icon-name: "view-grid-symbolic";
                    tooltip: _("Icons (Ctrl+1)");
                  }

                  Adw.Toggle {
                    name: "list";
                    icon-name: "view-list-symbolic";
                    tooltip: _("List (Ctrl+2)");
                  }

                  Adw.Toggle {
                    name: "columns";
                    icon-name: "foldav-view-columns-symbolic";
                    tooltip: _("Columns (Ctrl+3)");
                  }
                }

                Gtk.MenuButton view_options {
                  icon-name: "view-more-symbolic";
                  menu-model: view_menu;
                  tooltip-text: _("View Options");
                  styles ["flat"]
                }

                Gtk.WindowControls {
                  side: end;
                }
              }
            }

            // The tabs, when there is more than one (src/window/tabs.rs).
            [top]
            Adw.TabBar tab_bar {
              view: tab_view;
              autohide: true;
            }

            // A newer version installed (src/update.rs, src/window.rs `update_banner`).
            [top]
            Adw.Banner update_banner {
              title: _("Foldav was updated: restart it to use the new version");
              button-label: _("Restart");
              action-name: "app.restart";
            }

            content: Gtk.Stack files_stack {
              Gtk.StackPage {
                name: "loading";
                child: Adw.Spinner {
                  halign: center;
                  valign: center;
                  width-request: 32;
                  height-request: 32;
                };
              }

              // The three views of the same folder (src/window/views.rs); the lists in them
              // are made in code.
              Gtk.StackPage {
                name: "files";
                child: Gtk.Overlay {
                  child: Gtk.Stack view_stack {
                    Gtk.StackPage {
                      name: "icons";
                      child: Gtk.ScrolledWindow icons_scroll {};
                    }

                    Gtk.StackPage {
                      name: "list";
                      child: Gtk.ScrolledWindow list_scroll {};
                    }

                    Gtk.StackPage {
                      name: "columns";
                      child: Gtk.ScrolledWindow columns_scroll {
                        hscrollbar-policy: automatic;
                        vscrollbar-policy: never;

                        Gtk.Box columns {}
                      };
                    }
                  };

                  // What is selected, at the foot, as Nautilus' (src/window/views.rs
                  // `update_status`).
                  [overlay]
                  Gtk.Label selection_status {
                    halign: end;
                    valign: end;
                    margin-end: 12;
                    margin-bottom: 12;
                    visible: false;
                    can-target: false;
                    ellipsize: end;
                    styles ["selection-status"]
                  }

                  // While a search is on its way (src/window/views.rs `set_searching`).
                  [overlay]
                  Gtk.Box searching_status {
                    halign: start;
                    valign: end;
                    margin-start: 12;
                    margin-bottom: 12;
                    spacing: 8;
                    visible: false;
                    can-target: false;
                    styles ["selection-status"]

                    Adw.Spinner {
                      width-request: 16;
                      height-request: 16;
                    }

                    Gtk.Label {
                      label: _("Searching…");
                    }
                  }
                };
              }

              Gtk.StackPage {
                name: "empty";
                child: Adw.StatusPage {
                  icon-name: "folder-symbolic";
                  title: _("Empty Folder");
                };
              }

              Gtk.StackPage {
                name: "error";
                child: Adw.StatusPage error {
                  icon-name: "dialog-error-symbolic";
                  title: _("Cannot Load the Folder");

                  Gtk.Button {
                    label: _("Try Again");
                    action-name: "win.reload";
                    halign: center;
                    styles ["pill"]
                  }
                };
              }
            };
          };
        };
      }
    }
  };
}

// The pages of the tab bar: no content, a tab keeps its folder and history in the code, and
// the views are shared (src/window/tabs.rs).
Adw.TabView tab_view {}

// A right click on the files (src/window/ops.rs, `context_menu`); what does not apply to
// the place or the selection is left out.
menu file_menu {
  section {
    item {
      label: _("Open");
      action: "win.open";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Open in New Tab");
      action: "win.open-new-tab";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Open With…");
      action: "win.open-with";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Download…");
      action: "win.download";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Download as ZIP…");
      action: "win.download-zip";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("New Folder");
      action: "win.new-folder";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Upload Files…");
      action: "win.upload-files";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Upload Folder…");
      action: "win.upload-folder";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("Cut");
      action: "win.cut";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Copy");
      action: "win.copy";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Paste");
      action: "win.paste";
      hidden-when: "action-disabled";
    }
  }

  // Only the one that applies to what is selected (src/window/favorites.rs).
  section {
    item {
      label: _("Add to Favorites");
      action: "win.file-favorite";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Remove from Favorites");
      action: "win.file-unfavorite";
      hidden-when: "action-disabled";
    }
  }

  // What the server has (src/window/share.rs, versions.rs, tags.rs).
  section {
    item {
      label: _("Share…");
      action: "win.share";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Versions…");
      action: "win.versions";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Tags…");
      action: "win.tags";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Open in Browser");
      action: "win.open-browser";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("Rename…");
      action: "win.rename";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Move to Trash");
      action: "win.delete";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Restore");
      action: "win.restore";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Delete Permanently…");
      action: "win.delete-forever";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Empty Trash…");
      action: "win.empty-trash";
      hidden-when: "action-disabled";
    }
  }
}

// The ⋮ in the path bar: the folder shown.
menu path_menu {
  section {
    item {
      label: _("Add to Favorites");
      action: "win.favorite-add";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Remove from Favorites");
      action: "win.favorite-remove";
      hidden-when: "action-disabled";
    }
  }

  section {
    item {
      label: _("New Folder");
      action: "win.new-folder";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Upload Files…");
      action: "win.upload-files";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Upload Folder…");
      action: "win.upload-folder";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Paste");
      action: "win.paste";
      hidden-when: "action-disabled";
    }

    item {
      label: _("Empty Trash…");
      action: "win.empty-trash";
      hidden-when: "action-disabled";
    }
  }
}

// As Files' view menu (src/window/options.rs): the icon size's buttons are a widget the code
// puts in at "zoom".
menu view_menu {
  section {
    item {
      custom: "zoom";
    }
  }

  section {
    label: _("Sort");

    item {
      label: _("A-Z");
      action: "win.sort";
      target: "name";
    }

    item {
      label: _("Z-A");
      action: "win.sort";
      target: "name-desc";
    }

    item {
      label: _("Last Modified");
      action: "win.sort";
      target: "modified";
    }

    item {
      label: _("First Modified");
      action: "win.sort";
      target: "modified-asc";
    }

    item {
      label: _("Size");
      action: "win.sort";
      target: "size";
    }

    item {
      label: _("Type");
      action: "win.sort";
      target: "type";
    }
  }

  section {
    item (_("Show Hidden Files"), "win.show-hidden")
    item (_("Reload"), "win.reload")
  }

  section {
    item (_("Captions…"), "win.captions")
  }
}

menu main_menu {
  item (_("Preferences"), "win.preferences")
  item (_("Keyboard Shortcuts"), "app.shortcuts")
  item (_("About Foldav"), "app.about")
  item (_("Quit"), "app.quit")
}
