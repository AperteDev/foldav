{
  "id": "dev.aperte.Foldav",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "foldav-linux",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.gnome.OnlineAccounts",
    "--talk-name=org.freedesktop.secrets"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": { "CARGO_HOME": "/run/build/foldav/cargo" },
    "build-args": ["--share=network"]
  },
  "modules": [
    {
      "name": "foldav",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --locked -p foldav-linux",
        "make -C foldav/linux install-data PREFIX=/app BINDIR=/app/bin"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../..",
          "skip": ["target", "tmp", ".git", ".env", ".playwright-mcp", ".flatpak-builder", "flatpak_app", "repo"]
        }
      ]
    }
  ]
}
