// Run the Linux app straight from the workspace, without `make install`.
// The app is single-instance: if another copy (installed or a previous run) owns
// the bus name, a new launch just forwards to it. Quit it first with the task below.
[
  {
    "label": "linux: run",
    "command": "cargo run -p foldav-linux",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: run (release)",
    "command": "cargo run --release -p foldav-linux",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: run with debug logs",
    "command": "cargo run -p foldav-linux",
    "env": { "G_MESSAGES_DEBUG": "all", "RUST_BACKTRACE": "1" },
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: run in browser (Broadway)",
    // In make, not here: Zed runs commands through the user's shell (fish), not sh.
    "command": "make -C foldav/linux broadway",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: run in sandbox",
    // Own data and keyring entries, next to the normal app: for testing other connections.
    "command": "make -C foldav/linux sandbox",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "linux: reset sandbox",
    "command": "make -C foldav/linux sandbox-reset",
    "use_new_terminal": false,
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "linux: quit running instance",
    // --auto-start=no so this never D-Bus-activates an installed copy just to quit it.
    "command": "busctl --user --auto-start=no call dev.aperte.Foldav /dev/aperte/Foldav org.gtk.Actions Activate 'sava{sv}' quit 0 0 || true",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "test: unit tests",
    "command": "cargo test --workspace",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "test: against the server",
    // The Test account from .env (FOLDAV_URL, FOLDAV_USER, FOLDAV_PASS).
    "command": "cargo test -p foldav-core --features integration",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "check: fmt and clippy",
    // What CI will run: formatting, clippy with warnings as errors.
    "command": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "i18n: refresh translation catalogs",
    "command": "scripts/i18n.sh",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus",
    "hide": "on_success"
  }
]
